[DEFAULT]
VENV = /opt/argo-automation-cpas/

[general]
loggers = stdout, file, syslog
log_level = INFO
log_file = %(VENV)svar/log/argo-cpas.log
syslog_address = /dev/log
syslog_facility = user
request_timeout = 30.0
verify_ssl = true
retries = 3
retry_delay = 5.0
strip_ansi = true
daemon_sleep = 60

[automation]
tenants = AUTOMATION

[ams]
project = ARGO-MON-AUTOMATION
host = api.devel.msg.argo.grnet.gr
subscription = events-sub-2
token = AUTOMATION_TOKEN
url_api_integrations = /v1/integrations/{component}/by-project-name/{project-name}/refresh
token_component_admin = tOKen # [Insert Token Here]
components = argo-monbox, argo-archiver
pullmsgs = 1
ack = false
return_immediately = true
events = INIT_TOPOLOGY_CONNECTOR, INIT_POEM, INIT_MONITORING_BOX
tokens_spool = %(VENV)svar/spool/ams_tokens.json

[webapi]
host = api.devel.mon.argo.grnet.gr
url_api_config = /api/v2/feeds/topology
url_api_integrations = /api/v3/integrations/components/{component}/by-tenant-name/{tenant_name}/refresh
token_component_admin = t0k3n
components = monbox, connector, poem-admin, poem-viewer
tokens_spool = %(VENV)svar/spool/webapi_tokens.json

[statusapi]
api = https://api-status.devel.mon.argo.grnet.gr/v1/automation/tenants/{tenant_id}/status

[iam]
api = https://login-devel.einfra.grnet.gr/auth/realms/einfra/protocol/openid-connect/token
oidc_client_id = client-id
oidc_client_secret = client-secret
token_spool = %(VENV)svar/spool/iam_access.yaml

[ansible]
user_connector = user
group_connector = user
ssh_private_key = /home/user/.ssh/sshkey
defaults_file = %(VENV)setc/roles-defaults.yml
tokens_manual = %(VENV)setc/tokens.yml
connectors_playbook = connectors.yml
connectors_inventory = connectors.ini
poem_playbook = poem.yml
poem_inventory = poem.ini
poem_fqdn_suffix = devel.mon.argo.grnet.gr
poem_restapi_token = %(VENV)svar/spool/restapi_tokens.json
poem_superuserpassword = poempass
user_sensu = rocky
sensu_inventory = sensu.ini

[monboxgit]
git_repo_owner = ARGOeu
git_repo_name = argo-mon-deployment
git_ssh_key_path = path_to_repo_readwrite_ssh_key
git_branch_backend = address_to_git_branch_backend
backend_config_file_path = path/to/config/yaml_file
git_branch_agent = address_to_git_branch_agent
agent_config_file_path = path/to/config/yaml_file

